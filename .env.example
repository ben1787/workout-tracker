# Server-only. Never put this key in browser JavaScript or commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
PORT=8765
# Optional: shared account storage; omit for the local-only browser store.
DATABASE_URL=
# Required for externally hosted access outside Render (automatic on Render).
PUBLIC_ORIGIN=
# Private one-time owner enrollment code. Never publish this value.
SETUP_TOKEN=

# Remote Supabase connection: session pooler (port 5432), app-only role.
DATABASE_SSL=false
# Supabase's public root CA PEM; required when using its verified TLS connection.
DATABASE_SSL_CA=
